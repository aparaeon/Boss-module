{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "cobblemon:mega_evolution_helix",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particles/mega_evolution_helix"
			}
		},
		"curves": {
			"variable.size_factor": {
				"type": "catmull_rom",
				"input": "v.emitter_age",
				"horizontal_range": "v.emitter_lifetime",
				"nodes": [0, 0, 0.95, 0.93, 0.3, 0]
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.gradient_speed = 0.5;variable.curve_angle = 90;"
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 250,
				"max_particles": 1000
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 2
			},
			"minecraft:emitter_shape_point": {},
			"minecraft:particle_initialization": {
				"per_update_expression": " variable.helix_selector = 0.3 - v.particle_random_1 * 0.6;variable.pinch_factor = math.sin(v.particle_age * 180);variable.rotation_angle = v.emitter_age * 270;variable.base_x = math.cos(v.particle_age * v.curve_angle) * v.pinch_factor * v.helix_selector;variable.base_z = math.sin(v.particle_age * v.curve_angle) * v.pinch_factor * v.helix_selector;"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 1.05
			},
			"minecraft:particle_motion_parametric": {
				"relative_position": ["v.base_x * math.cos(v.rotation_angle) - v.base_z * math.sin(v.rotation_angle)", "v.particle_age + q.entity_height / 2 + 1", "v.base_x * math.sin(v.rotation_angle) + v.base_z * math.cos(v.rotation_angle)"]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.15 * v.size_factor", "0.15 * v.size_factor"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "math.mod(v.particle_age / v.particle_lifetime + v.emitter_age * v.gradient_speed, 1.0)",
					"gradient": {
						"0.0": "#FFFFFA00",
						"0.2": "#FF09FF00",
						"0.44": "#FF00F3FF",
						"0.67": "#FF3442FE",
						"0.88": "#FFD144FF",
						"1.0": "#FFFFFA00"
					}
				}
			}
		}
	}
}