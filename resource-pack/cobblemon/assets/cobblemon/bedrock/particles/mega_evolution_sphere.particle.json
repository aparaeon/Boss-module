{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "cobblemon:mega_evolution_sphere",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particles/mega_evolution_sphere"
			}
		},
		"curves": {
			"variable.spiral_rotation": {
				"type": "bezier",
				"input": "v.particle_age / v.particle_lifetime",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0, 2.22, 0, 0]
			},
			"variable.radius_factor": {
				"type": "catmull_rom",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [1, 1, 0.92, 0.86, 0.84, 0.9, 1, 1, 0.7, 0.5, 0.45, 1.2, 1, 1]
			},
			"variable.particle_size_factor": {
				"type": "bezier",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0.2, -0.46, 2.42, 0]
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "v.max_rotation_speed = 180;"
			},
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": false
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 2000,
				"max_particles": 1000
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.3
			},
			"minecraft:emitter_shape_point": {},
			"minecraft:particle_initialization": {
				"per_update_expression": "v.current_radius = math.max(2, q.entity_size * 1.1) * v.radius_factor;v.base_z = v.current_radius * (2 * v.particle_random_1 - 1);v.base_rxy = v.current_radius * math.sqrt(1 - math.pow(v.base_z / v.current_radius, 2));v.base_angle = 360 * v.particle_random_2;v.current_angle = v.base_angle + v.max_rotation_speed * v.spiral_rotation * (v.particle_random_3 * 4 + 1);v.x = v.base_rxy * math.cos(v.current_angle);v.y = v.base_z;v.z = v.base_rxy * math.sin(v.current_angle);"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 3
			},
			"minecraft:particle_motion_parametric": {
				"relative_position": ["v.x", "v.y", "v.z"]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["1.5 * v.particle_size_factor", "1.5 * v.particle_size_factor"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#00FFFFFF",
						"0.48": "#479956FF",
						"0.59": "#FFFF3FE4",
						"0.62": "#FFFF3FAA",
						"0.74": "#FFFFFFFF",
						"0.78": "#ffffffff",
						"0.95": "#00FFFFFF"
					}
				}
			},
			"cobblemon:emitter_space": {
                "scaling": "entity"
            }
		}
	}
}