{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "cobblemon:mega_evolution_balls",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particles/mega_evolution_ball"
			}
		},
		"curves": {
			"variable.size_factor": {
				"type": "bezier",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0, 0.82, 1.6, 0.3]
			},
			"variable.size_anim_factor": {
				"type": "catmull_rom",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0, 1, 0.7, 1, 0.7, 1, 0.7, 1, 0]
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.size = 0.2;variable.speed = 1;"
			},
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": false
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 100,
				"max_particles": 400
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 1.5
			},
			"minecraft:emitter_shape_sphere": {
				"radius": 6,
				"surface_only": true,
				"direction": "inwards"
			},
			"minecraft:particle_initialization": {
				"per_update_expression": "variable.size_anim = v.size * v.size_factor * v.size_anim_factor;"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 2
			},
			"minecraft:particle_initial_speed": "v.speed",
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": -1
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["v.size_anim", "v.size_anim"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_motion_collision": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#000058FF",
						"0.15": "#FF6200FF",
						"0.4": "#ffffffff",
						"0.83": "#FFFF1B89",
						"1.0": "#00FF1B77"
					}
				}
			}
		}
	}
}
