{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "cobblemon:mega_evolution_action_line_out",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particles/mega_evolution_action_line"
			}
		},
		"curves": {
			"variable.opacity": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0.15, 0.7, 0.15, 0]
			},
			"variable.spawn_rate_factor": {
				"type": "linear",
				"input": "v.emitter_age",
				"horizontal_range": "v.emitter_lifetime",
				"nodes": [0, 1, 1, 0.8, 0]
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.spawn_rate = 1000;"
			},
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": false
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": "v.spawn_rate * v.spawn_rate_factor",
				"max_particles": 4000
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_sphere": {
				"radius": "q.entity_size / 2",
				"surface_only": true,
				"direction": "outwards"
			},
			"minecraft:particle_initialization": {
				"per_update_expression": "variable.size = (math.clamp(v.particle_age * 5 / v.particle_lifetime, 0, 0.25)) * 4;variable.mirror_z = (math.round(v.particle_random_1) * 2 - 1) * (v.particle_random_2 * 0.8 + 0.2);"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 0.2
			},
			"minecraft:particle_initial_speed": 15,
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": ["v.size", "v.size * v.mirror_z"],
				"facing_camera_mode": "lookat_direction",
				"uv": {
					"texture_width": 64,
					"texture_height": 64,
					"uv": [0, 0],
					"uv_size": [64, 64]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": [1, 1, 1, "(v.particle_random_1 + 0.2) * v.opacity"]
			},
			"cobblemon:emitter_space": {
                "scaling": "entity"
            }
		}
	}
}